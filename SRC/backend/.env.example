# HomeFix - Đồ án Hệ quản trị cơ sở dữ liệu DBMS330284
PORT=3000
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=HomeFix_DBMS_Nhom08_TiengViet
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=false
# Set DB_AUTH=sql and fill DB_USER/DB_PASSWORD only if your SQL Server uses SQL authentication.
DB_USER=
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
# For a public HTTPS website, also add its exact origin to CLIENT_ORIGINS.

# OTP email: Gmail SMTP requires no custom domain.
OTP_EMAIL_PROVIDER=gmail
GMAIL_USER=
# Google App Password (16 characters), NOT your normal Google password.
GMAIL_APP_PASSWORD=

# Có thể chọn nhà cung cấp Resend bằng OTP_EMAIL_PROVIDER=resend.
RESEND_API_KEY=
OTP_EMAIL_FROM=
